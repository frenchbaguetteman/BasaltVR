diff --git a/src/d3d11/d3d11_resource_helper.cpp b/src/d3d11/d3d11_resource_helper.cpp
index 6624ed6..d8ddf14 100644
--- a/src/d3d11/d3d11_resource_helper.cpp
+++ b/src/d3d11/d3d11_resource_helper.cpp
@@ -433,9 +433,28 @@ CreateMTLTextureDescriptorInternal(
     } else {
       if (SampleCount > 1) {
         if (!pDevice->GetMTLDevice().supportsTextureSampleCount(SampleCount)) {
-          ERR("CreateMTLTextureDescriptorInternal: sample count ", SampleCount,
-              " is not supported.");
-          return E_INVALIDARG;
+          // Basalt: D3D11 feature level 11_0 guarantees 8x MSAA, but Apple
+          // GPUs stop at 4x. Games that ask for 8x without checking (Source 2
+          // Auto-Fidelity picks 8x) got E_INVALIDARG, then rendered into
+          // nothing. Use the largest supported count instead; the D3D11
+          // description keeps the requested count, and shaders read the real
+          // count from the texture.
+          UINT supported = SampleCount - 1;
+          while (supported > 1 &&
+                 !pDevice->GetMTLDevice().supportsTextureSampleCount(supported))
+            supported--;
+          if (supported <= 1) {
+            ERR("CreateMTLTextureDescriptorInternal: sample count ", SampleCount,
+                " is not supported.");
+            return E_INVALIDARG;
+          }
+          static bool warned = false;
+          if (!warned) {
+            warned = true;
+            WARN("CreateMTLTextureDescriptorInternal: sample count ", SampleCount,
+                 " is not supported; using ", supported, " samples.");
+          }
+          SampleCount = supported;
         }
         if (ArraySize > 1) {
           pDescOut->type = WMTTextureType2DMultisampleArray;
