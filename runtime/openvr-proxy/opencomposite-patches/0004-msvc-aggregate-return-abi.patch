     return "\n".join(lines)
 
 
+# Aggregates that OpenVR interface methods return by value. All are larger than 8 bytes.
+MSVC_AGGREGATE_RETURN_TYPES = ("HmdMatrix34_t", "HmdMatrix44_t", "HmdColor_t", "HiddenAreaMesh_t",
+                               "DistortionCoordinates_t")
+
+MSVC_AGGREGATE_RETURN_PRELUDE = """#ifndef OC_MSVC_AGGREGATE_RETURN
+#if defined(_WIN32) && defined(__GNUC__)
+#define OC_MSVC_AGGREGATE_RETURN 1
+#else
+#define OC_MSVC_AGGREGATE_RETURN 0
+#endif
+#endif
+#ifndef OC_AGGREGATE_RETURN_PTR
+// Kept out of the plain 'Type Name(' shape so the stub generator parses only the
+// portable declaration below each one.
+#define OC_AGGREGATE_RETURN_PTR(type) type*
+#endif
+"""
+
+_aggregate_decl = re.compile(
+    r"^(?P<indent>[ \t]*)virtual (?P<type>" + "|".join(MSVC_AGGREGATE_RETURN_TYPES) +
+    r") (?P<name>\w+)\((?P<args>[^;]*)\)(?P<tail>\s*= 0;.*)$", re.MULTILINE)
+
+
+def msvc_aggregate_return(text: str) -> str:
+    def repl(m):
+        args = m.group("args").strip()
+        ret_arg = f"{m.group('type')} *_ocRet"
+        new_args = f" {ret_arg}, {args} " if args else f" {ret_arg} "
+        return (f"#if OC_MSVC_AGGREGATE_RETURN\n"
+                f"{m.group('indent')}virtual OC_AGGREGATE_RETURN_PTR({m.group('type')}) {m.group('name')}({new_args}){m.group('tail')}\n"
+                f"#else\n"
+                f"{m.group(0)}\n"
+                f"#endif")
+
+    new_text, count = _aggregate_decl.subn(repl, text)
+    if count:
+        new_text = MSVC_AGGREGATE_RETURN_PRELUDE + new_text
+    return new_text
+
+
 def write_interface(target: str, result: str, usingiface: bool, interface_checker: Callable, out_dir: Path):
     """
     Writes an interface out to a file.
@@ -210,6 +250,13 @@ def write_interface(target: str, result: str, usingiface: bool, interface_checke
     if target in patches:
         result = patch(result, input_dir / f"patches/{target}.ipatch")
 
+    # MinGW (GCC and Clang) pass the hidden aggregate-return pointer of a C++ method before
+    # 'this', while MSVC passes 'this' first, then the return pointer, and returns that
+    # pointer in RAX. Games are MSVC-built, so a MinGW OpenComposite must declare these
+    # vtable slots in the MSVC shape. See msvc_aggregate_return() below.
+    if usingiface:
+        result = msvc_aggregate_return(result)
+
