 cflag_spec = re.compile(r"\[(?P<name>\w+)\]\s*=\s*(?P<value>.*)")
 
+# Must match MSVC_AGGREGATE_RETURN_TYPES in split_headers.py. With OC_MSVC_AGGREGATE_RETURN
+# (MinGW builds), these methods take the return pointer after 'this' and return it, like MSVC.
+MSVC_AGGREGATE_RETURN_TYPES = ("HmdMatrix34_t", "HmdMatrix44_t", "HmdColor_t", "HiddenAreaMesh_t",
+                               "DistortionCoordinates_t")
+
+
+def _returns_aggregate(func) -> bool:
+    return func.return_type.split("::")[-1].strip() in MSVC_AGGREGATE_RETURN_TYPES
+
+
+def _sret_args(func) -> str:
+    args = func.args_str()
+    return f"{func.return_type} *_ocRet" + (f", {args}" if args else "")
+
 
