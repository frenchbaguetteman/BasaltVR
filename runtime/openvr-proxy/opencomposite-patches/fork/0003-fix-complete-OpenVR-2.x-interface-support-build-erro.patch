diff --git a/scripts/libparse.py b/scripts/libparse.py
index 03100a824dd452e4d8aa752a930fcb1a505c60a1..c7ca6d8a5ecec0e203559aff7ab941ace2c9d8a8 100644
--- a/scripts/libparse.py
+++ b/scripts/libparse.py
@@ -9,7 +9,7 @@ regex = re.compile(regex_src)
