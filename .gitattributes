* text=auto

*.c text eol=lf
*.cpp text eol=lf
*.h text eol=lf
*.md text eol=lf
# Patch context lines must match the patched source byte for byte, trailing
# whitespace included, so `git diff --check` skips them.
*.patch text eol=lf -whitespace
*.swift text eol=lf
*.yml text eol=lf
*.zsh text eol=lf

*.dll binary
*.icns binary
*.png binary
*.so binary
*.zip binary
